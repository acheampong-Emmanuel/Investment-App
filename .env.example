PORT=4173
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173,http://localhost:8080,file://
CACHE_TTL_SECONDS=300
HISTORY_CACHE_TTL_SECONDS=3600
PUBLIC_DATA_MODE=true
DEFAULT_COUNTRY=US
DEFAULT_PROVIDER=auto
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=info

ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
POLYGON_API_KEY=
NEWS_API_KEY=
HF_TOKEN_ENCRYPTION_KEY=
DEFAULT_HF_MODEL=google/gemma-2-2b-it:fastest
HF_MODEL_OPTIONS=google/gemma-2-2b-it:fastest,meta-llama/Llama-3.1-8B-Instruct,openai/gpt-oss-20b
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT_MS=30000
